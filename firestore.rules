rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionPath(code) {
      return /databases/$(database)/documents/sessions/$(code);
    }

    function session(code) {
      return get(sessionPath(code)).data;
    }

    function isMaster(code) {
      return signedIn() && (session(code).masterUid == request.auth.uid
        || ('activityId' in session(code) && manages(session(code).activityId)));
    }

    function activityPath(id) {
      return /databases/$(database)/documents/activities/$(id);
    }
    function manages(id) {
      return signedIn() && (get(activityPath(id)).data.ownerUid == request.auth.uid
        || exists(/databases/$(database)/documents/activities/$(id)/managers/$(request.auth.uid)));
    }
    function currentRound(code) {
      return !('activityId' in session(code))
        || (get(activityPath(session(code).activityId)).data.status == 'open'
          && get(activityPath(session(code).activityId)).data.currentSession == code);
    }
    function validRound(id, code) {
      let s = getAfter(sessionPath(code)).data;
      return s.activityId == id && s.phase == 'waiting' && s.createdAt == request.time;
    }

    // Public activity documents never contain the private management key.
    match /activities/{id} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create: if signedIn() && id.matches('^[a-f0-9]{12}$')
        && request.resource.data.keys().hasOnly(['title','ownerUid','status','currentSession','roundNumber','createdAt','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open' && request.resource.data.roundNumber == 1
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && validRound(id, request.resource.data.currentSession);
      allow update: if manages(id) && resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
              && request.resource.data.status == 'closed')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSession','roundNumber','updatedAt'])
              && request.resource.data.roundNumber == resource.data.roundNumber + 1
              && request.resource.data.currentSession != resource.data.currentSession
              && validRound(id, request.resource.data.currentSession)));
      match /managers/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow list, update, delete: if false;
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key.matches('^[a-f0-9]{64}$')
          && get(activityPath(id)).data.status == 'open'
          && get(/databases/$(database)/documents/activityKeys/$(request.resource.data.key)).data.activityId == id;
      }
    }
    match /activityKeys/{key} {
      // 256-bit capability. Known-key lookup only; enumeration is forbidden.
      allow get: if signedIn() && key.matches('^[a-f0-9]{64}$');
      allow list, update, delete: if false;
      allow create: if signedIn() && key.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['activityId','ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(activityPath(request.resource.data.activityId)).data.ownerUid == request.auth.uid
        && getAfter(activityPath(request.resource.data.activityId)).data.status == 'open';
    }

    match /sessions/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'code',
          'masterUid',
          'phase',
          'activePosition',
          'questionOrder',
          'totalQuestions',
          'createdAt',
          'updatedAt'
          ,'activityId'
        ])
        && request.resource.data.code == code
        && ((!('activityId' in request.resource.data) && code.matches('^[0-9]{3}$'))
          || ('activityId' in request.resource.data && code.matches('^[a-f0-9]{32}$')
            && getAfter(activityPath(request.resource.data.activityId)).data.status == 'open'
            && getAfter(activityPath(request.resource.data.activityId)).data.currentSession == code
            && (getAfter(activityPath(request.resource.data.activityId)).data.ownerUid == request.auth.uid
              || exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId)/managers/$(request.auth.uid)))))
        && request.resource.data.masterUid == request.auth.uid
        && request.resource.data.phase == 'waiting'
        && request.resource.data.activePosition == 0
        && request.resource.data.totalQuestions >= 1
        && request.resource.data.totalQuestions <= 50
        && request.resource.data.questionOrder.size() == request.resource.data.totalQuestions
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isMaster(code) && currentRound(code)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['phase', 'activePosition', 'nextSessionCode', 'updatedAt'])
        && request.resource.data.phase in [
          'waiting',
          'open',
          'locked',
          'revealed',
          'finished'
        ]
        && request.resource.data.activePosition >= 0
        && request.resource.data.activePosition < resource.data.totalQuestions
        && (!request.resource.data.keys().hasAny(['nextSessionCode'])
          || (request.resource.data.nextSessionCode.matches('^[0-9]{3}$')
            && request.resource.data.nextSessionCode != code
            && existsAfter(/databases/$(database)/documents/sessions/$(request.resource.data.nextSessionCode))))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /participants/{participantId} {
        // Projectieschermen lezen deze anonieme registraties uitsluitend om
        // het aantal verbonden deelnemers in de zaal te kunnen tonen.
        allow read: if signedIn();

        allow create: if signedIn() && currentRound(code)
          && request.auth.uid == participantId
          && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'lastSeen'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeen == request.time;

        allow update: if signedIn() && currentRound(code)
          && request.auth.uid == participantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.lastSeen == request.time;

        allow delete: if false;
      }

      match /answers/{answerId} {
        // Antwoorden bevatten geen naam of contactgegeven. Lezen is nodig voor
        // het live projectiescherm; wijzigen of verwijderen is nooit toegestaan.
        allow read: if signedIn();

        allow create: if signedIn() && currentRound(code)
          && request.resource.data.keys().hasOnly([
            'participantUid',
            'questionPosition',
            'optionIndex',
            'answeredAt'
          ])
          && request.resource.data.participantUid == request.auth.uid
          && answerId == request.auth.uid + '_' + string(request.resource.data.questionPosition)
          && request.resource.data.questionPosition == session(code).activePosition
          && session(code).phase == 'open'
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex <= 3
          && request.resource.data.answeredAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
